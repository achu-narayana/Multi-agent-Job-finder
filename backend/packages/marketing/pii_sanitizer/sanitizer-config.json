{
  "company_blocklist": [],
  "person_blocklist": [],
  "custom_patterns": [],
  "skip_paths": [
    "node_modules",
    ".git",
    "__pycache__",
    ".venv",
    ".env.example",
    "pii_sanitizer/sanitizer-config.json"
  ],
  "allow_patterns": [
    "api_key=ANTHROPIC_API_KEY",
    "api_key = get_",
    "API_KEY=\"your-",
    "0123456789",
    "@example.com",
    "@acme.com",
    "@host.com",
    "(555)",
    "+1-555",
    "123-45-6789",
    "user:pass@"
  ],
  "placeholder_format": "bracket",
  "_comment": "Add your own name, employers, and other identifiers to the blocklists so they are caught before résumé or outreach data is committed."
}
